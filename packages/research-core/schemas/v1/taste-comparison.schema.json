{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/research-core/v1/taste-comparison.schema.json",
  "title": "Pairwise Research Taste Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "batch_id", "recorded_at", "winner_paper_id", "loser_paper_id", "reason_codes", "rationale", "actor", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "comparison_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "recorded_at": {"type": "string"},
    "winner_paper_id": {"type": "string"},
    "loser_paper_id": {"type": "string"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["importance", "mechanism", "identification", "data", "measurement", "surprise", "feasibility", "contradiction", "duplicate", "low-fit", "time-cost"]}
    },
    "rationale": {"type": "string"},
    "actor": {"const": "human"},
    "provenance": {"type": "object", "additionalProperties": true}
  }
}
